# Copy this file to .env and adjust if needed. The defaults work with Ollama + Gemma 4.

# ---- AI provider (open-weight models only) ----
# ollama  = local inference on your own computer (default, most private)
# openai  = any OpenAI-compatible server hosting an open-weight model
#           (LM Studio, vLLM, llama.cpp server, Ollama's /v1, OpenRouter, Hugging Face router ...)
# none    = built-in rule engine only, no AI model
AI_PROVIDER=ollama
AI_TIMEOUT=180

# Ollama (https://ollama.com). Pull the model first:  ollama pull gemma4:e4b
#   gemma4:e2b  -> smallest, for 8 GB RAM laptops
#   gemma4:e4b  -> recommended default (reads screenshots too)
#   gemma4:26b  -> best quality if you have a strong GPU
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# OpenAI-compatible server (only used when AI_PROVIDER=openai).
# Use your provider's exact model id for an open-weight model such as Gemma 4.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Flask ----
SECRET_KEY=change-me-to-a-random-string

# ---- History / privacy ----
SAVE_HISTORY=true
REDACT_STORED_MESSAGES=true
# DATABASE_PATH=database.db
MAX_MESSAGE_CHARS=8000

# ---- Gmail (see README -> "Connect Gmail") ----
# Easiest: save the OAuth client file from Google Cloud Console as client_secret.json in this folder.
# Or set the values here instead:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must match the redirect URI in Google Cloud Console exactly. Open the app at 127.0.0.1, not localhost.
GMAIL_REDIRECT_URI=http://127.0.0.1:5000/oauth2callback
GMAIL_SCAN_LIMIT=25
